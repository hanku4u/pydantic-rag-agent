# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# One OpenRouter key covers all three model calls: the agent, image
# captioning, and embeddings, all through OpenRouter's OpenAI-compatible API.
OPENROUTER_API_KEY=

# Every setting below is optional; the defaults are shown. Names are nested:
# PRAGENT_ + the node path with __ between levels + the field.
# The full reference is docs/reference/configuration.md.
#
# Provider — chat and caption model.
# PRAGENT_PROVIDER__MODEL=deepseek/deepseek-v4.1-flash
# PRAGENT_PROVIDER__CAPTION_MODEL=
# PRAGENT_PROVIDER__BASE_URL=https://openrouter.ai/api/v1
# PRAGENT_PROVIDER__API_KEY=
#
# Embeddings — the index's identity. Changing MODEL or DIMENSIONS requires
# re-ingesting; the startup guard refuses a mismatch rather than mixing vectors.
# PRAGENT_EMBEDDINGS__MODEL=qwen/qwen3-embedding-8b
# PRAGENT_EMBEDDINGS__DIMENSIONS=1024
# PRAGENT_EMBEDDINGS__BASE_URL=https://openrouter.ai/api/v1
# PRAGENT_EMBEDDINGS__API_KEY=
#
# Vector store — chroma (persistent) or memory (process-local).
# PRAGENT_VECTOR_STORE__BACKEND=chroma
# PRAGENT_VECTOR_STORE__CHROMA_PATH=./data/chroma
# PRAGENT_VECTOR_STORE__COLLECTION=chunks
#
# Original documents, copied at ingest so citations keep working.
# PRAGENT_STORAGE__DOCUMENTS__BACKEND=local
# PRAGENT_STORAGE__DOCUMENTS__LOCAL_PATH=./data/documents
# PRAGENT_STORAGE__DOCUMENTS__S3_BUCKET=
# PRAGENT_STORAGE__DOCUMENTS__S3_PREFIX=documents/
# PRAGENT_STORAGE__DOCUMENTS__S3_REGION=
#
# Extracted images and the caption cache.
# PRAGENT_STORAGE__IMAGES__DIRECTORY=./data/images
#
# Ingestion — overlap must be smaller than chunk size.
# PRAGENT_INGESTION__CHUNK_SIZE=800
# PRAGENT_INGESTION__CHUNK_OVERLAP=100
#
# Agent — retrieval and conversation behaviour.
# PRAGENT_AGENT__TOP_K=5
# PRAGENT_AGENT__MIN_SCORE=
# PRAGENT_AGENT__MAX_TOOL_CALLS=8
# PRAGENT_AGENT__HISTORY_TURNS=6
# PRAGENT_AGENT__MAX_CONVERSATIONS=500
#
# Logging.
# PRAGENT_LOG_LEVEL=INFO
#
# Client-only: makes the CLI and Streamlit talk to a running API instead of
# building the agent in-process. Not part of Settings.
# PRAGENT_API_URL=http://127.0.0.1:8000
