# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# One OpenRouter key covers all three model calls: the agent (DeepSeek),
# image captioning, and embeddings (Voyage, via OpenRouter's
# OpenAI-compatible embeddings endpoint).
OPENROUTER_API_KEY=

# Optional overrides. Uncomment to change; defaults shown.
# PRAGENT_MODEL=openrouter:deepseek/deepseek-v4.1-flash
# PRAGENT_CAPTION_MODEL=
# PRAGENT_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# PRAGENT_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# PRAGENT_EMBEDDING_DIMENSIONS=1024
# PRAGENT_CHUNK_SIZE=800
# PRAGENT_CHUNK_OVERLAP=100
# PRAGENT_TOP_K=5
# PRAGENT_MIN_SCORE=0.2
# PRAGENT_MAX_TOOL_CALLS=8
# PRAGENT_CHROMA_PATH=./data/chroma
# PRAGENT_IMAGE_DIR=./data/images
# PRAGENT_LOG_LEVEL=INFO
# PRAGENT_API_URL=http://127.0.0.1:8000
