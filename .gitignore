# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Test and tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Environment and secrets
.env
.env.*
!.env.example

# Editors and OS cruft
.vscode/
.idea/
.DS_Store

# NOTE: uv.lock is intentionally NOT ignored. It is the reproducible
# dependency graph and belongs in version control.
